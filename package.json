{
  "name": "orichal",
  "version": "0.1.0",
  "private": true,
  "description": "Orichal, a simulated spot crypto exchange: a plain HTML, CSS and JavaScript client served with its API by Express (server phase, CE-2).",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/src/server.js",
    "start": "node server/src/server.js",
    "seed": "node server/scripts/seed.js",
    "db:check-ledger": "node server/scripts/check-ledger.js",
    "check:data": "node scripts/check-data.mjs",
    "boards": "node scripts/extract-boards.mjs",
    "vendor": "node scripts/copy-vendor.mjs",
    "shots": "node scripts/screenshots.mjs",
    "compare": "node scripts/compare.mjs",
    "checks": "node scripts/checks/run.mjs"
  },
  "devDependencies": {
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "mongodb-memory-server": "^11.4.0",
    "playwright": "^1.64.1",
    "qrcode-generator": "^2.0.4",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.13.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  }
}
