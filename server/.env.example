# Orichal server settings: every variable the server reads, with a safe example.
# Copy this file to server/.env and change what you need. In PowerShell:
#   Copy-Item server/.env.example server/.env
# server/.env is git-ignored: real secrets go there and never into a commit.
# Every variable has a default except the JWT secrets (required from M6), so the
# server also starts without a server/.env. Variables already set in the real
# environment win over the file.

# development, production (hides error details) or test
NODE_ENV=development

# One origin for the client and the API: http://localhost:5173
PORT=5173

# Local MongoDB, or the Atlas SRV string with the database name /orichal, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orichal?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/orichal

# Signing keys for the access and refresh tokens: two different random strings
# of at least 32 characters. Make each one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes: a number followed by s, m, h or d
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# bcrypt cost factor (each step doubles the work); the checks use 4 to run fast
BCRYPT_ROUNDS=12

# USDT credited to a new account, as a decimal string
DEMO_CREDIT_USDT=10000

# The JSON store for the collections that aren't in MongoDB, from the repository root
STORE_FILE=server/data/store.json

# Seed an empty database at start (the checks use true)
SEED_ON_START=false

# Mount /api/v1/demo/reset and /api/v1/demo/fail-next for the Simulator menu
DEMO_CONTROLS=true

# The mock's simulated network delay; the checks turn it on to see loading states
DEMO_LATENCY=false

# With DEMO_CONTROLS, also mount the routes only the checks use
TEST_ROUTES=false
